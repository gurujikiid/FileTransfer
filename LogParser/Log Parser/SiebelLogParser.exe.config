<?xml version="1.0"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="SiebelLogParser.My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
        </sectionGroup>
    </configSections>
    <system.diagnostics>
        <sources>
            <!-- This section defines the logging configuration for My.Application.Log -->
            <source name="DefaultSource" switchName="DefaultSwitch">
                <listeners>
                    <add name="FileLog"/>
                    <!-- Uncomment the below section to write to the Application Event Log -->
                    <!--<add name="EventLog"/>-->
                </listeners>
            </source>
        </sources>
        <switches>
            <add name="DefaultSwitch" value="Information"/>
        </switches>
        <sharedListeners>
            <add name="FileLog" type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" initializeData="FileLogWriter"/>
            <!-- Uncomment the below section and replace APPLICATION_NAME with the name of your application to write to the Application Event Log -->
            <!--<add name="EventLog" type="System.Diagnostics.EventLogTraceListener" initializeData="APPLICATION_NAME"/> -->
        </sharedListeners>
    </system.diagnostics>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0,Profile=Client"/></startup><userSettings>
        <SiebelLogParser.My.MySettings>
            <setting name="Expand" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="ParseAfterLoad" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="Workflow" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="Signal" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="Errors" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="Warning" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="SQL" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="SQLTime" serializeAs="String">
                <value>0</value>
            </setting>
            <setting name="Wait" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="WaitTime" serializeAs="String">
                <value>2</value>
            </setting>
            <setting name="SWE" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="SWELevel" serializeAs="String">
                <value>Limited</value>
            </setting>
            <setting name="Language" serializeAs="String">
                <value>ENU</value>
            </setting>
            <setting name="PropertyType" serializeAs="String">
                <value>Rich Text</value>
            </setting>
            <setting name="Count" serializeAs="String">
                <value>0</value>
            </setting>
            <setting name="Performance" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="MenuParser" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="MenuBehaviour" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="MenuFile" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="MenuEdit" serializeAs="String">
                <value>True</value>
            </setting>
        </SiebelLogParser.My.MySettings>
    </userSettings>
</configuration>
